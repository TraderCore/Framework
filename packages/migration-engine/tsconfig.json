{
    "extends": "../../tooling/typescript-config/node.json",
    "compilerOptions": {
        "baseUrl": "./src",
        "outDir": "dist",
        "rootDir": "src",
        "declarationDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "moduleResolution": "Node",
        "module": "CommonJS",
        "target": "ES2022",
        "allowSyntheticDefaultImports": true
    },
    "include": ["./src/**/*.ts"],
    "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
