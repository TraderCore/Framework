{
    "name": "@tradercore/monorepo",
    "version": "1.0.0",
    "description": "TraderCore Framework - A powerful trading platform framework",
    "author": "TheGoatedDev",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/tradercore/framework.git"
    },
    "bugs": {
        "url": "https://github.com/tradercore/framework/issues"
    },
    "homepage": "https://tradercore.com",
    "keywords": [
        "trading",
        "framework",
        "finance",
        "typescript",
        "bun"
    ],
    "workspaces": [
        "apps/*",
        "cli",
        "core",
        "packages/*",
        "plugins/*",
        "tooling/*"
    ],
    "scripts": {
        "============== TURBO ==============": "",
        "build": "turbo build",
        "test": "turbo test",
        "dev": "turbo dev",
        "check-types": "turbo check-types",
        "============== LINTING ==============": "",
        "lint": "turbo lint-format",
        "lint:fix": "turbo lint-format:fix",
        "lint-format": "biome check .",
        "lint-format:fix": "biome check . --fix",
        "============== APPLICATIONS ==============": "",
        "app:admin": "bun --filter @tradercore/app-admin-dashboard",
        "app:client": "bun --filter @tradercore/app-client-dashboard",
        "app:api": "bun --filter @tradercore/app-api",
        "app:cli": "bun --filter @tradercore/cli",
        "============== RELEASE ==============": "",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release:publish": "bun run build && changeset publish",
        "============== SCRIPTS ==============": "",
        "prepare": "husky && syncpack lint",
        "lint-staged": "lint-staged",
        "commitlint": "commitlint --edit"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.4",
        "@changesets/cli": "2.29.8",
        "@commitlint/cli": "20.4.2",
        "@commitlint/config-conventional": "20.4.2",
        "@types/bun": "1.2.9",
        "bun-types": "1.2.9",
        "husky": "9.1.7",
        "lint-staged": "16.2.7",
        "rimraf": "6.1.3",
        "syncpack": "14.0.0",
        "turbo": "2.8.11"
    },
    "license": "GPL-3.0-only",
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json}": [
            "biome check --fix"
        ]
    },
    "packageManager": "bun@1.3.9"
}
